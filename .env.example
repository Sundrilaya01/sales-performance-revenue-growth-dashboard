# Environment Configuration Template
# Copy this file to .env and configure local settings.
# Note: The .env file contains local settings and is excluded from Git via .gitignore.

# Web Application Settings
SERVER_HOST=localhost
SERVER_PORT=8050

# Database Settings (For production integration)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sales_analytics
DB_USER=analytics_user
DB_PASSWORD=your_secure_password_here

# API and Ingestion Settings
API_ENV=development
API_LOG_LEVEL=INFO
